rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── ヘルパー関数 ─────────────────────────────────────────────

    // 認証済みユーザーか確認
    function isAuthenticated() {
      return request.auth != null;
    }

    // 対象ドキュメントの parentUid が自分のUID と一致するか
    function isParentOf(childData) {
      return isAuthenticated() && request.auth.uid == childData.parentUid;
    }

    // 書き込みデータ（ドキュメント全体）が許可フィールドのみか確認（create 用）
    function onlyFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // update で実際に変更されたフィールドのみが許可フィールドか確認（update 用）
    // request.resource.data は書き込み後のドキュメント全体を表すため、
    // onlyFields() をそのまま update に使うと parentUid/createdAt のような
    // 「作成時のみ設定され、以後クライアントが触らないフィールド」が
    // 許可リストに無いだけで正当な更新まで拒否されてしまう。
    // diff().affectedKeys() で「今回の書き込みで変化したキー」だけを見ることで、
    // 未変更フィールドの有無に関係なく安全に判定できる。
    function onlyChangedFields(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ─── users ────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:  if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId
                    && onlyChangedFields(['email', 'childIds', 'updatedAt']);
      allow delete: if false; // 削除は Cloud Functions 経由のみ
    }

    // ─── children ─────────────────────────────────────────────────
    match /children/{childId} {
      // 読み取り: 親ユーザー本人のみ
      allow read: if isAuthenticated()
                  && request.auth.uid == resource.data.parentUid;

      // 作成: 認証済みユーザーが自分の子として作成
      // フィールドを許可リストに限定した上、初期値（未プレイ・無課金状態）であることを強制する。
      // これが無いと、作成時点で totalProfit や currentLevel に任意の値を仕込んで
      // 「プレイ済み・無課金なのに進捗済み」の状態を偽装できてしまう。
      allow create: if isAuthenticated()
                    && request.auth.uid == request.resource.data.parentUid
                    && request.resource.data.planType == 'free'
                    && request.resource.data.hasPremium == false
                    && request.resource.data.totalProfit == 0
                    && request.resource.data.totalRevenue == 0
                    && request.resource.data.consecutiveDays == 0
                    && request.resource.data.currentLevel in [1, 2, 3]
                    && request.resource.data.storeLevel == 'small'
                    && onlyFields([
                        'parentUid', 'name', 'avatarId', 'currentLevel', 'storeLevel',
                        'totalProfit', 'totalRevenue', 'consecutiveDays',
                        'createdAt', 'lastPlayedAt', 'planType', 'hasPremium'
                      ]);

      // 更新: 親ユーザーのみ、かつ制限フィールド
      // 注意: planType / hasPremium はここに含めない。
      // 課金状態はストア(RevenueCat)の検証を経た Cloud Functions からのみ変更されるべきで、
      // クライアントから書き込み可能にすると誰でも直接 Firestore を更新して
      // 課金なしでプレミアム機能を有効化できてしまう（決済バイパスの脆弱性）。
      allow update: if isAuthenticated()
                    && request.auth.uid == resource.data.parentUid
                    && onlyChangedFields([
                        'name', 'avatarId', 'currentLevel', 'storeLevel',
                        'totalProfit', 'totalRevenue', 'consecutiveDays',
                        'lastPlayedAt', 'updatedAt'
                      ])
                    // planType / hasPremium は不変（Cloud Functions 経由でのみ変更）
                    && request.resource.data.planType == resource.data.planType
                    && request.resource.data.hasPremium == resource.data.hasPremium;

      // 削除: 不可（Cloud Functions 経由のみ）
      allow delete: if false;
    }

    // ─── gameSessions ──────────────────────────────────────────────
    match /gameSessions/{sessionId} {
      // 読み取り: 対象の子の親ユーザー
      allow read: if isAuthenticated()
                  && exists(/databases/$(database)/documents/children/$(resource.data.childUid))
                  && get(/databases/$(database)/documents/children/$(resource.data.childUid)).data.parentUid == request.auth.uid;

      // 作成: 対象の子の親ユーザーのみ
      allow create: if isAuthenticated()
                    && exists(/databases/$(database)/documents/children/$(request.resource.data.childUid))
                    && get(/databases/$(database)/documents/children/$(request.resource.data.childUid)).data.parentUid == request.auth.uid;

      // 更新・削除: 不可（Cloud Functions 経由のみ）
      allow update, delete: if false;
    }

    // ─── conceptMasteries ─────────────────────────────────────────
    match /conceptMasteries/{childUid} {
      // 読み取り: 対象の子の親ユーザー
      allow read: if isAuthenticated()
                  && exists(/databases/$(database)/documents/children/$(childUid))
                  && get(/databases/$(database)/documents/children/$(childUid)).data.parentUid == request.auth.uid;

      // 書き込み: Cloud Functions のみ（直接書き込み不可）
      allow write: if false;
    }

    // ─── seasonEvents ─────────────────────────────────────────────
    match /seasonEvents/{eventId} {
      // 全認証ユーザーが読み取り可能
      allow read: if isAuthenticated();
      // 書き込みは Cloud Functions のみ
      allow write: if false;
    }

    // ─── weeklyChallenges ─────────────────────────────────────────
    match /weeklyChallenges/{challengeId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ─── rankings ─────────────────────────────────────────────────
    match /rankings/{rankingId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ─── npcStates ────────────────────────────────────────────────
    // NPC の好感度・常連状態を子どもごとに管理
    match /npcStates/{childUid}/npcs/{npcId} {
      // 読み取り・書き込み: 対象の子の親ユーザー
      allow read, write: if isAuthenticated()
                         && exists(/databases/$(database)/documents/children/$(childUid))
                         && get(/databases/$(database)/documents/children/$(childUid)).data.parentUid == request.auth.uid;
    }

    // ─── dailyChallenges ──────────────────────────────────────────
    // 日替わりチャレンジ（子どもごと）
    match /children/{childUid}/dailyChallenges/{date} {
      allow read: if isAuthenticated()
                  && exists(/databases/$(database)/documents/children/$(childUid))
                  && get(/databases/$(database)/documents/children/$(childUid)).data.parentUid == request.auth.uid;

      allow create, write: if isAuthenticated()
                           && exists(/databases/$(database)/documents/children/$(childUid))
                           && get(/databases/$(database)/documents/children/$(childUid)).data.parentUid == request.auth.uid;
    }

    // ─── weeklyChallenges ─────────────────────────────────────────
    // 週間チャレンジ（子どもごと）
    match /children/{childUid}/weeklyChallenges/{challengeId} {
      allow read: if isAuthenticated()
                  && exists(/databases/$(database)/documents/children/$(childUid))
                  && get(/databases/$(database)/documents/children/$(childUid)).data.parentUid == request.auth.uid;

      allow create, write: if isAuthenticated()
                           && exists(/databases/$(database)/documents/children/$(childUid))
                           && get(/databases/$(database)/documents/children/$(childUid)).data.parentUid == request.auth.uid;
    }

    // ─── badges ───────────────────────────────────────────────────
    // 取得したバッジ（子どもごと）
    match /children/{childUid}/badges/{badgeId} {
      allow read: if isAuthenticated()
                  && exists(/databases/$(database)/documents/children/$(childUid))
                  && get(/databases/$(database)/documents/children/$(childUid)).data.parentUid == request.auth.uid;

      allow create: if isAuthenticated()
                    && exists(/databases/$(database)/documents/children/$(childUid))
                    && get(/databases/$(database)/documents/children/$(childUid)).data.parentUid == request.auth.uid;

      allow update, delete: if false;
    }

    // ─── titles ───────────────────────────────────────────────────
    // 装備中の称号（子どもごと）
    match /children/{childUid}/titles/{titleId} {
      allow read: if isAuthenticated()
                  && exists(/databases/$(database)/documents/children/$(childUid))
                  && get(/databases/$(database)/documents/children/$(childUid)).data.parentUid == request.auth.uid;

      allow create, write: if isAuthenticated()
                           && exists(/databases/$(database)/documents/children/$(childUid))
                           && get(/databases/$(database)/documents/children/$(childUid)).data.parentUid == request.auth.uid;
    }

    // ─── streaks ──────────────────────────────────────────────────
    // 連続プレイ情報（子どもごと）
    match /children/{childUid}/streaks/{streakId} {
      allow read: if isAuthenticated()
                  && exists(/databases/$(database)/documents/children/$(childUid))
                  && get(/databases/$(database)/documents/children/$(childUid)).data.parentUid == request.auth.uid;

      allow create, write: if isAuthenticated()
                           && exists(/databases/$(database)/documents/children/$(childUid))
                           && get(/databases/$(database)/documents/children/$(childUid)).data.parentUid == request.auth.uid;
    }

    // ─── その他コレクション ───────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
